# Python
__pycache__/
*.pyc
.venv/

# Never commit data, mods, or game files
*.archive
*.zip
*.7z
*.rar
*.dll
*.log
*.msgpack
library/
state/
logs/

# OS / editor
Thumbs.db
.DS_Store
.vscode/

