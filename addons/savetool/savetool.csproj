<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional add-on for Cyber Loader: copies parts of a Cyberpunk 2077 character between two saves.
       Built on CP2077SaveEditor / CyberCAT-SimpleGUI (MIT, Deweh and contributors). Build with
         dotnet build -c Release -p:EditorDir=<folder with the unzipped editor>
       (tools\build-savetool.ps1 does this and installs the result). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8981;CS0618;CS8632</NoWarn>
    <AssemblyName>savetool</AssemblyName>
    <ServerGarbageCollector>true</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CP2077SaveEditor"><HintPath>$(EditorDir)\CP2077SaveEditor.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.RED4"><HintPath>$(EditorDir)\WolvenKit.RED4.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.Common"><HintPath>$(EditorDir)\WolvenKit.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.Core"><HintPath>$(EditorDir)\WolvenKit.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
